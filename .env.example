# URL base de la API Laravel (equipo backend)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# URL pública del portal (usada para metadata, sitemap y JSON-LD)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# true: usa datos simulados locales (MSW + seeds). false: consume la API real.
NEXT_PUBLIC_USE_MOCKS=true
